# .env.example — Copy to .env and fill in real values (never commit .env to git).

# ── Gemini (Google AI Studio free tier — no billing required) ─────────────────
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash

# ── Qdrant Cloud (free-forever cluster — no credit card required) ─────────────
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=library

# ── Google Drive (Service Account) ───────────────────────────────────────────
# For LOCAL development: paste the raw service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# For RENDER deployment: paste base64-encoded version of the JSON
# (encode with: python -c "import base64,sys; print(base64.b64encode(open('sa.json','rb').read()).decode())")
GOOGLE_SERVICE_ACCOUNT_B64=

# The Google Drive folder ID to ingest from
# (last segment of the folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ── Embedding model (no key needed — runs locally) ────────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Chunking tuning ───────────────────────────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
